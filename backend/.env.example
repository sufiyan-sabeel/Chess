# Checkmate backend — copy to `.env` and edit. NEVER commit `.env`.
#   cp .env.example .env
# All values below are placeholders (no secrets).

# development | test | production
APP_ENV=development
# verbose error payloads only ever in development (production always returns generic errors)
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_VERSION=1.0.0

# Private MariaDB instance (backend/var/db), started by bin/dev.sh / bin/test.sh
DB_HOST=127.0.0.1
DB_PORT=3307
# Optional unix socket; when set it is preferred over host/port.
DB_SOCKET=
DB_NAME=checkmate
DB_USER=checkmate
DB_PASSWORD=change-me

# Comma separated allowlist. Never use `*` together with credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://10.0.2.2:8080

# Opaque token TTLs (seconds): access 15 min, refresh 30 days
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Hard request body cap
BODY_MAX_BYTES=65536

# Password policy (register / reset-password)
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_LETTER=true
PASSWORD_REQUIRE_DIGIT=true

# Transports:
#   file -> appends messages (incl. raw tokens) to backend/var/mail.log.
#           DEVELOPMENT ONLY: MailerFactory refuses it when APP_ENV=production.
#   smtp -> not implemented here (no provider/credentials in this environment).
#   null -> no transport: /auth/resend-verification returns 503 MAIL_NOT_CONFIGURED
#           and dev-only flows surface `dev_preview` when APP_ENV=development.
# Production needs a real Mailer implementation (SMTP/API) before e-mail works.
MAIL_TRANSPORT=file
MAIL_FROM=no-reply@checkmate.local

# Rate limits (requests per window, per IP + route)
RATE_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_VERIFY=10
RATE_LIMIT_RESEND=3
RATE_LIMIT_FORGOT=3
RATE_LIMIT_RESET=5
RATE_LIMIT_DEFAULT=120
