# --- Build outputs ---
build/
app/build/
dist/
.gradle/
.kotlin/
local.properties
captures/
*.apk
*.aab
*.ap_
*.dex
*.class
*.hprof

# --- Local Android toolchain (downloaded by tools/bootstrap-toolchain.sh) ---
tools/toolchain/

# --- Signing material: NEVER commit keys or passwords ---
*.jks
*.keystore
*.p12
*.pem
*.b64
keystore.properties

# --- Backend secrets ---
.env
.env.local
backend/.env
backend/.env.local
backend/vendor/
backend/var/
backend/var.log
.phpunit.cache

# --- Databases / local data ---
*.sqlite3
*.db
# root-level scratch data only (unanchored `data/` would swallow app asset
# directories such as js/data/puzzles.js — the bug CI caught)
/data/

# --- Node ---
node_modules/
npm-debug.log*

# --- Editors / OS ---
.DS_Store
.idea/
*.iml
.vscode/

# --- Logs ---
*.log
!docs/*.md
